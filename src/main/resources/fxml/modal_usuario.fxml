<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.avitech.sia.iu.RegUsuarioController" spacing="15" styleClass="modal-content">
    <padding><Insets topRightBottomLeft="20"/></padding>

    <Label fx:id="lblTitle" text="Registrar Nuevo Usuario" styleClass="h3"/>

    <GridPane hgap="10" vgap="12">
        <columnConstraints>
            <ColumnConstraints prefWidth="120"/>
            <ColumnConstraints prefWidth="250" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Usuario" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtUsuario" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Contraseña" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="pwPassword" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Rol" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbRol" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Email" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmail" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Teléfono" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTelefono" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Dirección" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtDireccion" prefRowCount="3" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#onDelete" styleClass="danger" visible="false" managed="false"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" onAction="#onCancel" styleClass="secondary"/>
        <Button text="Guardar" onAction="#onSave" styleClass="primary"/>
    </HBox>

</VBox>
