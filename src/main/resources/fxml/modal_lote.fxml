<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.avitech.sia.iu.RegLoteController" spacing="15" styleClass="modal-content">
    <padding><Insets topRightBottomLeft="20"/></padding>

    <Label fx:id="lblTitle" text="Gestionar Lote" styleClass="h3"/>

    <GridPane hgap="10" vgap="12">
        <columnConstraints>
            <ColumnConstraints prefWidth="120"/>
            <ColumnConstraints prefWidth="250" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Nombre del Lote" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="tfNombreLote" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Estado" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbEstado" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Cantidad de Gallinas" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="tfCantidadGallinas" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#onCancel" styleClass="secondary"/>
        <Button text="Guardar" onAction="#onSave" styleClass="primary"/>
    </HBox>

</VBox>
